[sub_resource type="CSharpScript" id="CSharpScript_ibotj"]
script/source = "sing Godot;
using System;

// 类名必须和文件名 drag.cs 完全一致（全小写）
public partial class Drag : ScrollContainer
{
	private bool _isDrag = false;
	private float _startPos = 0f;
	private VScrollBar _vScrollBar;

	public override void _Ready()
	{
		_vScrollBar = GetVScrollBar();
		if (_vScrollBar == null)
		{
			GD.PrintErr(\"未找到垂直滚动条！请开启 ScrollContainer 的垂直滚动\");
		}
	}

	// 绑定 gui_input 信号的方法
	public void OnGuiInput(InputEvent @event)
	{
		if (_vScrollBar == null) return;

		// 鼠标左键按下
		if (@event is InputEventMouseButton mouseBtnEvent && 
			mouseBtnEvent.ButtonIndex == MouseButton.Left && 
			mouseBtnEvent.IsPressed())
		{
			_isDrag = true;
			_startPos = mouseBtnEvent.Position.Y;
		}

		// 鼠标左键松开
		if (@event is InputEventMouseButton releaseBtnEvent && 
			releaseBtnEvent.ButtonIndex == MouseButton.Left && 
			!releaseBtnEvent.IsPressed())
		{
			_isDrag = false;
			_startPos = 0f;
		}

		// 拖拽滚动
		if (_isDrag && @event is InputEventMouseMotion mouseMotionEvent)
		{
			float offset = mouseMotionEvent.Position.Y - _startPos;
			_vScrollBar.Value = _vScrollBar.Value - offset;
			_startPos = mouseMotionEvent.Position.Y;
		}
	}
}
"

